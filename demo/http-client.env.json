{
  "$curliteshared": {
    "clientId": "demo-client",
    "apiVersion": "v1",
    "$default_headers": {
      "Accept": "application/json",
      "X-Api-Version": "{{apiVersion}}"
    }
  },
  "dev": {
    "host": "https://httpbin.org",
    "verbose": true,
    "$default_headers": {
      "X-Client-Id": "{{clientId}}"
    }
  },
  "local": {
    "host": "http://127.0.0.1:8080",
    "$default_headers": {
      "X-Api-Version": false
    }
  }
}
