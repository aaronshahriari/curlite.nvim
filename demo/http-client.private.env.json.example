// Copy this to http-client.private.env.json and put your real secrets in it.
// That filename is gitignored; this one is the template that is committed.
//
// Values here are merged over the matching environment in
// http-client.env.json, so you only repeat the keys you want to override.
{
  "dev": {
    "clientSecret": "put-the-real-secret-here"
  }
}
